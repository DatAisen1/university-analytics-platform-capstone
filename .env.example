# Copy this file to .env and fill in real values. .env is git-ignored — never commit real secrets.

# ---------------------------------------------------------------------------
# PostgreSQL (the data warehouse)
# ---------------------------------------------------------------------------
POSTGRES_USER=uap_admin
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=university_analytics
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Service role passwords (see warehouse/ddl/002_grants.sql +
# pipelines/common/postgres.py). Each role gets a distinct, narrowly-scoped
# set of permissions -- see docs/06_Data_Warehouse.md Section 5.
PIPELINE_WRITER_PASSWORD=change_me_locally_pw
DBT_ROLE_PASSWORD=change_me_locally_dbt
DASHBOARD_READER_PASSWORD=change_me_locally_dash
ANALYST_READONLY_PASSWORD=change_me_locally_analyst

# ---------------------------------------------------------------------------
# MinIO (S3-compatible object storage for Bronze/Silver/Gold files)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=uap_minio_admin
MINIO_ROOT_PASSWORD=change_me_locally_too
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_BRONZE_BUCKET=bronze
MINIO_SILVER_BUCKET=silver
MINIO_GOLD_BUCKET=gold

# ---------------------------------------------------------------------------
# Pipeline runtime (used from Week 2 onward)
# ---------------------------------------------------------------------------
ENVIRONMENT=dev
LOG_LEVEL=INFO

# STORAGE_BACKEND controls which ObjectStorage every pipeline stage uses
# by default (Bronze/Silver/Gold reads+writes), including Dagster runs --
# see pipelines/common/storage.py::load_storage_from_env.
#   local  -- (default) write to warehouse/{bronze,silver,gold}_store/ on
#             disk. No MinIO/Docker required. Correct for this sandbox and
#             for `pytest`.
#   minio  -- write through S3Storage against the MINIO_* settings above.
#             Requires `docker compose up` (or an equivalent reachable
#             MinIO/S3) with the bronze/silver/gold buckets already
#             created (see scripts/create_minio_buckets.py).
STORAGE_BACKEND=local

# ---------------------------------------------------------------------------
# Optional overrides (all have safe defaults -- see pipelines/common/settings.py).
# Uncomment only if you need a non-default value.
# ---------------------------------------------------------------------------
# ALEMBIC_DATABASE_URL is read directly by migrations/env.py (Alembic's own
# entry point) to point the CLI `alembic upgrade head` at a specific database
# without editing alembic.ini. Not needed for the normal pipeline/test flow,
# which reuses an already-open Postgres connection instead.
# ALEMBIC_DATABASE_URL=postgresql+psycopg2://uap_admin:change_me_locally@localhost:5432/university_analytics

# DBT_PROFILES_DIR=dbt
# DAGSTER_HOME=
